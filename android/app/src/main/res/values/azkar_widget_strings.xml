<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="widget_app_name">الشيخ أحمد</string>
    <!-- Shown as the widget's own name in the launcher's widget picker.
         Without it the picker falls back to the application label, so the
         entry reads "Sheikh Ahmed" with no hint of what the widget does. -->
    <string name="widget_label">أذكار</string>
    <string name="widget_description">مواقيت الصلاة والتاريخ الهجري ومهمة الأسبوع وذكر متغيّر</string>
    <!-- The full-screen adhan alert (AdhanAlertActivity). Native
         strings rather than the Flutter translations: this screen is
         built by a broadcast receiver with no Flutter engine running,
         so it cannot reach them. The prayer name itself does come
         from Dart, in the alarm's extras, and replaces the title
         below. -->
    <string name="adhan_alert_label">حان الآن موعد</string>
    <string name="adhan_alert_title">الصلاة</string>
    <string name="adhan_alert_body">حيّ على الصلاة · حيّ على الفلاح</string>
    <string name="adhan_alert_stop">إيقاف الأذان</string>
    <string name="adhan_alert_dismiss">إغلاق مع استمرار الأذان</string>
    <!-- The dhikr card (ZikrAlertActivity). Native strings for the
         same reason as the adhan alert: no Flutter engine is running
         when a receiver builds this. The dhikr itself comes from Dart
         in the alarm's extras. -->
    <string name="zikr_alert_label">ذكر</string>
    <string name="zikr_alert_fallback">سُبْحَانَ اللَّهِ وَبِحَمْدِهِ</string>
    <string name="zikr_alert_hint">اضغط للإغلاق</string>
    <string name="widget_mission_label">مهمة الأسبوع</string>
    <string name="widget_next_label">الصلاة القادمة</string>
    <!--
      Short, widely-known dhikr/ayah phrases for the home-screen widget
      (see AzkarWidgetProvider.kt) — bundled natively rather than read
      from the Flutter side, since the widget's periodic refresh
      (onUpdate) can fire without the Flutter engine running at all.
    -->
    <string-array name="azkar_widget_phrases">
        <item>سُبْحَانَ اللَّهِ وَبِحَمْدِهِ</item>
        <item>لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ</item>
        <item>أَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ</item>
        <item>اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ</item>
        <item>حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ</item>
        <item>لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ</item>
        <item>رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً</item>
        <item>الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ</item>
        <item>وَمَن يَتَّقِ اللَّهَ يَجْعَل لَّهُ مَخْرَجًا</item>
        <item>إِنَّ مَعَ الْعُسْرِ يُسْرًا</item>
    </string-array>
</resources>
